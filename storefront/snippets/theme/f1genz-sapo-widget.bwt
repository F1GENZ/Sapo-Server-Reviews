{{# Sapo .bwt Theme Snippets for F1GENZ Reviews + Q&A #}}
{{# Mode A — metafield SSR (D2 confirmed: .bwt reads shop + product metafields) #}}
{{# Copy these snippets into your Sapo theme .bwt templates. #}}

{{###############################################################################
  SNIPPET 1: Global loader — paste into theme.bwt before </body>
  Loads the web component runtime JS/CSS from your API server.
  Requires shop.metafields.f1genz.config to be set (auto-written on app install).
################################################################################}}

{{# ------ theme.bwt (before </body>) ------ #}}
{{ assign f1genzConfig = shop.metafields.f1genz.config | default: "" }}
{{ if f1genzConfig != "" }}
  {{ assign f1genzApiUrl = f1genzConfig.apiUrl | default: "" }}
  {{ if f1genzApiUrl != "" }}
    <script>
      window.__F1GENZ_STOREFRONT_CONFIG = {
        apiUrl: "{{ f1genzApiUrl }}",
        store: "{{ shop.domain }}"
      };
    </script>
    <link rel="stylesheet" href="{{ f1genzApiUrl }}/storefront/f1genz-storefront.css">
    <script defer src="{{ f1genzApiUrl }}/storefront/f1genz-storefront.js"></script>
  {{ endif }}
{{ endif }}


{{###############################################################################
  SNIPPET 2: Product reviews widget — paste into product.bwt
  Renders <f1genz-reviews> web component with product ID.
################################################################################}}

{{# ------ product.bwt (reviews section) ------ #}}
<div class="f1genz-sapo-review-section">
  <f1genz-reviews
    product-id="{{ product.id }}"
    storeDomain="{{ shop.domain }}"
    {{ if customer }}customer-email="{{ customer.email }}"{{ endif }}
  ></f1genz-reviews>
</div>


{{###############################################################################
  SNIPPET 3: Q&A panel — paste into product.bwt
  Renders <f1genz-qna-panel> web component.
################################################################################}}

{{# ------ product.bwt (Q&A section) ------ #}}
<div class="f1genz-sapo-review-section">
  <f1genz-qna-panel
    product-id="{{ product.id }}"
    storeDomain="{{ shop.domain }}"
  ></f1genz-qna-panel>
</div>


{{###############################################################################
  SNIPPET 4: Rating badge — paste into collection.bwt (product card) or product.bwt
  SSR via metafield (Mode A). Only renders if public_summary exists.
################################################################################}}

{{# ------ collection.bwt / product card (rating badge) ------ #}}
{{ assign publicSummary = product.metafields.reviews.public_summary }}
{{ if publicSummary }}
  {{ assign summaryObj = publicSummary | json_parse }}
  {{ assign avg = summaryObj.avg | default: 0 }}
  {{ assign count = summaryObj.count | default: 0 }}
  {{ if count > 0 }}
    <f1genz-rating-badge
      product-id="{{ product.id }}"
      storeDomain="{{ shop.domain }}"
      avg-rating="{{ avg }}"
      review-count="{{ count }}"
      distribution='{{ publicSummary }}'
    ></f1genz-rating-badge>
  {{ endif }}
{{ endif }}


{{###############################################################################
  SNIPPET 5: JSON-LD structured data — paste into product.bwt <head>
  Google Rich Results compatible Product + Review aggregateRating schema.
################################################################################}}

{{# ------ product.bwt (JSON-LD in <head>) ------ #}}
{{ assign publicSummaryLd = product.metafields.reviews.public_summary }}
{{ if publicSummaryLd }}
  {{ assign ld = publicSummaryLd | json_parse }}
  {{ assign ldAvg = ld.avg | default: 0 }}
  {{ assign ldCount = ld.count | default: 0 }}
  {{ if ldCount > 0 }}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": "{{ product.title | escape }}",
        "url": "{{ canonical_url }}",
        "image": "{{ product.image.src }}",
        {{ if product.vendor }}"brand": { "@type": "Brand", "name": "{{ product.vendor | escape }}" },{{ endif }}
        {{ if product.sku }}"sku": "{{ product.sku }}",{{ endif }}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ ldAvg }}",
          "reviewCount": "{{ ldCount }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
    </script>
  {{ endif }}
{{ endif }}
