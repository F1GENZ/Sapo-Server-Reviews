# App runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# false | hop count 1-10 | comma list of proxy IPs/CIDRs (loopback, linklocal, uniquelocal allowed).
# "true" and malformed values fail startup. Must be set explicitly in production; use false only
# when the app is directly exposed. Set the hop count only after observing the real proxy chain.
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
WEBHOOK_BODY_LIMIT=256kb
# Interface the API binds. Production uses 127.0.0.1 because only cloudflared reaches it.
LISTEN_HOST=0.0.0.0

# AI reply suggestion (Cloudflare Workers AI).
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Sapo OAuth
# Sapo tokens are permanent — no refresh token, no token expiry
SAPO_CLIENT_ID=replace-with-client-id
# Client secret of the Sapo app (used for launch-link and webhook HMAC verification).
SAPO_CLIENT_SECRET=replace-with-sapo-app-client-secret
SAPO_SCOPE=read_products,write_products,read_orders
SAPO_INSTALL_CALLBACK_URL=http://localhost:3000/api/oauth/install/callback
SAPO_LOGIN_CALLBACK_URL=http://localhost:3000/api/oauth/install/login/callback

# Sessions
# At least 32 bytes and different from SAPO_CLIENT_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SESSION_SECRET=replace-with-generated-session-secret-min-32-bytes
APP_SESSION_TTL_SECONDS=43200
SESSION_HANDOFF_TTL_SECONDS=120
SESSION_COOKIE_NAME=sapo_app_session
SESSION_COOKIE_DOMAIN=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-redis-password-if-required
REDIS_TLS=false
REDIS_KEY_PREFIX=sapo-app-base

# Database
DATABASE_URL=postgresql://app_user:replace-with-db-password@localhost:5432/sapo_app_base?schema=public
DIRECT_URL=postgresql://app_user:replace-with-db-password@localhost:5432/sapo_app_base?schema=public
# 32-byte key, base64-encoded. The public sample key is rejected at startup; generate your own.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key

# Sapo API rate limiting
SAPO_API_MAX_CONCURRENT=4

# R2 media upload: set all three or none. R2_UPLOAD_SECRET needs at least 32 bytes and also
# authorizes Worker list/delete, so it must never be a placeholder.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
R2_WORKER_URL=https://f1genz-sapo-reviews-media.your-subdomain.workers.dev
R2_UPLOAD_SECRET=replace-with-generated-upload-secret-min-32-bytes
R2_PUBLIC_DOMAIN=replace-with-r2-public-domain

# Public ingress limits
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60
SESSION_EXCHANGE_RATE_LIMIT_MAX=60
PUBLIC_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_WRITE_RATE_LIMIT_MAX=20

# Readiness
READINESS_TOKEN=replace-with-monitoring-token
BUILD_SHA=local
