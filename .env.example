# App runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
WEBHOOK_BODY_LIMIT=256kb

# Sapo OAuth
# Sapo tokens are permanent — no refresh token, no token expiry
SAPO_CLIENT_ID=replace-with-client-id
SAPO_CLIENT_SECRET=replace-with-client-secret
SAPO_SCOPE=read_products write_products read_orders write_orders read_customers write_customers read_script_tags write_script_tags read_themes write_themes
SAPO_INSTALL_CALLBACK_URL=http://localhost:3000/api/oauth/install/callback
SAPO_LOGIN_CALLBACK_URL=http://localhost:3000/api/oauth/login/callback

# Webhooks
SAPO_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Sessions
APP_SESSION_SECRET=replace-with-32-byte-random-secret
APP_SESSION_TTL_SECONDS=43200
SESSION_HANDOFF_TTL_SECONDS=120
SESSION_COOKIE_NAME=sapo_app_session
SESSION_COOKIE_DOMAIN=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-redis-password-if-required
REDIS_TLS=false
REDIS_KEY_PREFIX=sapo-app-base

# Database
DATABASE_URL=postgresql://app_user:replace-with-db-password@localhost:5432/sapo_app_base?schema=public
DIRECT_URL=postgresql://app_user:replace-with-db-password@localhost:5432/sapo_app_base?schema=public
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Sapo API rate limiting
SAPO_API_MAX_CONCURRENT=4
SAPO_API_MIN_INTERVAL_MS=250

# R2 media upload
R2_WORKER_URL=https://f1genz-sapo-r2-upload.your-subdomain.workers.dev
R2_UPLOAD_SECRET=replace-with-upload-secret
R2_PUBLIC_DOMAIN=images-sapo.f1genz.dev

# Public ingress limits
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_RATE_LIMIT_MAX=300
SESSION_EXCHANGE_RATE_LIMIT_MAX=60

# Readiness
READINESS_TOKEN=replace-with-monitoring-token
BUILD_SHA=local
